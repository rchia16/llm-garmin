{
  "name": "local-workout-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic local-first workout engine",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:core": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "demo": "npm run build && node dist/demo.js",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}

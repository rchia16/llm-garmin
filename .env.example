# Optional configuration for the experimental local Python Garmin bridge.
# Loaded explicitly from the repository root; existing environment values win.
# Copy this file to .env for local configuration. Never commit .env.

# Optional Garmin login email. Password and MFA input should be prompted locally.
GARMIN_EMAIL=

# Absolute path outside the repository for sensitive authentication/session tokens.
# Example on Windows: C:/Users/YOUR_USERNAME/AppData/Local/LocalWorkoutBuilder/garmin
# Leave blank for the OS-appropriate LocalWorkoutBuilder/garmin private directory.
# Do not assume $env:LOCALAPPDATA or ~ will expand in a .env file.
GARMIN_SESSION_DIR=

# Never put passwords, MFA codes, or token contents here.
# Do not prefix private configuration with VITE_: it can reach the browser bundle.
